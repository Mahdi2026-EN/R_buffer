# Copy this file to secrets.properties and fill in your values.
# secrets.properties is git-ignored.

spring.datasource.password=YOUR_DATABASE_PASSWORD

# At least 32 random characters, e.g.:  openssl rand -base64 48
app.jwt.secret=PUT_A_LONG_RANDOM_SECRET_HERE

# First administrator (created on first start when no admin exists)
app.admin.email=admin@yourdomain.com
app.admin.password=CHANGE_ME_choose_a_strong_password
